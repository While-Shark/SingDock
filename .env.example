# Set your VPS public IP or domain (recommended for correct share links).
PUBLIC_HOST=
# WARP is optional: enable both, then rebuild the image.
INSTALL_WARP=false
ENABLE_WARP=false
# Set true only after accepting Cloudflare's terms.
WARP_ACCEPT_TOS=false

# Optional GUI. Keep loopback and use an SSH tunnel or HTTPS reverse proxy.
ENABLE_GUI=false
GUI_BIND=127.0.0.1
GUI_PORT=18100
GUI_USERNAME=admin
GUI_PATH=/
GUI_PASSWORD=
